{
  "protocol_id": "awm-ppo-lagrangian-baseline-v1",
  "status": "locked_before_formal_training",
  "base_ppo_protocol_id": "awm-ppo-baseline-v1",
  "risk_contract_id": "awm-risk-contract-v1",
  "evaluation_contract_id": "awm-learned-method-evaluation-v1",
  "scientific_role": "standard expected-constraint learned baseline; not tail-risk aware and not an LCVaR optimizer",
  "objective": {
    "reward_per_step": "-executed_policy_irrigation_mm / 495",
    "primary": "maximize expected negative controllable irrigation",
    "published_total_irrigation": "45 mm fixed preplant + policy irrigation"
  },
  "constraint": {
    "retention": "R_pi(w)=Y_pi(w)/Y_ref(w)",
    "per_eta_signed_cost": "C_eta(w)=eta-R_pi(w)",
    "expected_constraint": "E_w[C_eta(w) | eta] <= 0",
    "equivalent_form": "E_w[R_pi(w) | eta] >= eta",
    "eta_levels": [0.9, 0.95, 0.98],
    "eta_grouping": "separate expected constraint and separate multiplier for every eta",
    "training_weather_measure": "uniform over ERA5 2000-2017",
    "terminal_cost_only": true,
    "cost_clipped_at_zero": false,
    "reason_signed_cost": "signed deficit implements an expected-retention constraint; positive surplus can compensate deficit, deliberately distinguishing this baseline from the LCVaR tail-risk constraint"
  },
  "lagrangian": {
    "multipliers": "one scalar lambda_eta for each registered eta",
    "initial_value": 1.0,
    "dual_learning_rate": 0.05,
    "projection": "lambda_eta <- max(0, lambda_eta + 0.05 * mean_training_cost_eta)",
    "upper_bound": null,
    "update_order": "actor/reward-critic/cost-critic use lambda_k on one complete balanced rollout; projected dual ascent then produces lambda_{k+1}",
    "extra_environment_episodes": 0,
    "parameter_source_note": "initial multiplier 1.0 and penalty learning rate 0.05 use the scale of OpenAI Safety Starter Agents PPO-Lagrangian defaults and are frozen before this baseline is trained"
  },
  "policy": {
    "observation_dim": 79,
    "actor_hidden_dims": [256, 128],
    "activation": "tanh",
    "layer_normalization": true,
    "hierarchical_action": "Bernoulli irrigation gate + active-only tanh-Gaussian amount latent",
    "amount_log_std": "state_dependent",
    "architecture_must_match_ppo_v1": true
  },
  "critics": {
    "reward_critic_hidden_dims": [256, 128],
    "cost_critic_hidden_dims": [256, 128],
    "separate_networks": true,
    "reward_gamma": 1.0,
    "reward_gae_lambda": 1.0,
    "cost_gamma": 1.0,
    "cost_gae_lambda": 1.0
  },
  "actor_update": {
    "lagrangian_advantage": "A_L=A_reward-lambda_eta*A_cost",
    "normalization": "normalize the combined A_L once across the full 6750-transition batch after applying eta-specific multipliers",
    "ppo_clip_epsilon": 0.2,
    "update_epochs": 10,
    "minibatch_size": 450,
    "entropy_coefficient": 0.0,
    "max_grad_norm": 0.5
  },
  "optimizer": {
    "learning_rate": 0.0001,
    "adam_beta1": 0.9,
    "adam_beta2": 0.999,
    "adam_eps": 1e-8,
    "reward_value_loss_coefficient": 0.5,
    "cost_value_loss_coefficient": 0.5
  },
  "rollout": {
    "training_years": [2000, 2001, 2002, 2003, 2004, 2005, 2006, 2007, 2008, 2009, 2010, 2011, 2012, 2013, 2014, 2015, 2016, 2017],
    "eta_levels": [0.9, 0.95, 0.98],
    "episodes_per_update": 54,
    "horizon_steps": 125,
    "transitions_per_update": 6750,
    "balanced_cartesian_product": true,
    "normalizer_frozen_within_rollout": true
  },
  "interaction_budget": {
    "max_updates_per_seed": 200,
    "training_episodes_per_seed": 10800,
    "decision_transitions_per_seed": 1350000,
    "must_match_ppo_v1": true,
    "all_training_dssat_trajectories_count": true
  },
  "training": {
    "seeds": [11, 21, 31, 41, 51],
    "max_updates": 200,
    "recovery_checkpoint_interval_updates": 1,
    "candidate_checkpoint_interval_updates": 10,
    "validation_interval_updates": 10,
    "candidate_checkpoint_count_per_seed": 20,
    "validation_episodes_per_candidate": 15,
    "validation_episodes_per_seed": 300
  },
  "evaluation": {
    "validation_years": [2018, 2019, 2020, 2021, 2022],
    "validation_action_mode": "deterministic",
    "final_test_action_mode": "deterministic",
    "checkpoint_selection": "reuse awm-learned-method-evaluation-v1 without modification",
    "formal_risk_metric": "LCVaR_0.20 retention is evaluation/model-selection only; PPO-Lagrangian training optimizes the expected-retention constraint",
    "locked_final_test_station_years": [2023, 2024, 2025]
  },
  "change_rule": "Any change after formal PPO-Lagrangian training starts requires a new protocol version."
}
